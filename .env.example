# Copy values into your shell environment before starting main.py.
# Do not commit real credentials or put MongoDB credentials in frontend files.
# MongoDB is OPTIONAL. Leave these unset to keep Discoveries in data/discoveries.json.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=utopia

# Optional SPHEREx tuning
# SPHEREX_UPSTREAM_CONCURRENCY=4
# SPHEREX_RETRIES=4
# SPHEREX_CHANGE_WORKERS=6
# SPHEREX_CACHE_MB=400
# SPHEREX_DISK_CACHE_MB=1500
# SPHEREX_DISK_CACHE=1
